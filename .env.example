# ============================================================
#  多作物叶片病害智能诊断系统 · 环境变量示例
#  用法：cp .env.example .env  然后按需修改
#  注意：.env 已被 .gitignore 忽略，请勿把真实密钥提交到仓库
# ============================================================

# ---------- 必改：安全密钥 ----------
# JWT / 会话签名密钥。生产环境请用随机串，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-string

# ---------- 可选：数据库 ----------
# 不配置时默认使用 SQLite（server/app.db），适合单机/小规模使用。
# 生产多进程部署建议改为 PostgreSQL，例如：
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/crop_disease
# DATABASE_URL=sqlite:///./server/app.db

# ---------- 可选：模型路径 ----------
# 默认 weights/best_model.pth；若同目录存在同名 .onnx，服务会优先用 ONNX 推理
# MODEL_PATH=weights/best_model.pth

# ---------- 可选：跨域白名单 ----------
# 生产环境请改成你的前端域名（逗号分隔）；* 表示允许所有来源（仅建议开发用）
# CORS_ORIGINS=https://your-frontend.example.com

# ---------- 可选：上传限制 ----------
# MAX_UPLOAD_MB=10

# ---------- 时区 ----------
TZ=Asia/Shanghai
